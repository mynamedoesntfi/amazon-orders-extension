{
  "manifest_version": 3,
  "name": "Amazon Orders Extension",
  "description": "Export Amazon cart data to CSV",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amazon Orders Extension"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.amazon.es/*",
    "https://*.amazon.co.jp/*",
    "https://*.amazon.in/*",
    "https://*.amazon.com.au/*",
    "https://*.amazon.com.br/*",
    "https://*.amazon.com.mx/*",
    "https://*.amazon.nl/*",
    "https://*.amazon.ae/*",
    "https://*.amazon.sg/*",
    "https://*.amazon.com.tr/*",
    "https://*.amazon.sa/*",
    "https://*.amazon.se/*",
    "https://*.amazon.pl/*",
    "https://*.amazon.com.be/*",
    "https://*.amazon.eg/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "480022033266-bum80179g229dv8se0uprrf83gh92b92.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/your-orders/orders*",
        "https://www.amazon.co.uk/your-orders/orders*",
        "https://www.amazon.ca/your-orders/orders*",
        "https://www.amazon.de/your-orders/orders*",
        "https://www.amazon.fr/your-orders/orders*",
        "https://www.amazon.it/your-orders/orders*",
        "https://www.amazon.es/your-orders/orders*",
        "https://www.amazon.co.jp/your-orders/orders*",
        "https://www.amazon.in/your-orders/orders*",
        "https://www.amazon.com.au/your-orders/orders*",
        "https://www.amazon.com.br/your-orders/orders*",
        "https://www.amazon.com.mx/your-orders/orders*",
        "https://www.amazon.nl/your-orders/orders*",
        "https://www.amazon.ae/your-orders/orders*",
        "https://www.amazon.sg/your-orders/orders*",
        "https://www.amazon.com.tr/your-orders/orders*",
        "https://www.amazon.sa/your-orders/orders*",
        "https://www.amazon.se/your-orders/orders*",
        "https://www.amazon.pl/your-orders/orders*",
        "https://www.amazon.com.be/your-orders/orders*",
        "https://www.amazon.eg/your-orders/orders*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
